{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "thread-handoff/review.schema.json",
  "title": "<thread-id>-REVIEW.jsonl の1行",
  "description": "行の種類は2列目のキーで決まる。status なら指摘の行、kind なら経緯の行。キーは properties の順に並べる（x-keyOrder）。値の文字列は1行で、バックスラッシュを含まない。x-warnMaxLength は目安の字数で、超えると警告になる。",
  "x-keyOrder": true,
  "oneOf": [
    { "$ref": "#/$defs/issue" },
    { "$ref": "#/$defs/event" }
  ],
  "$defs": {
    "line": {
      "description": "1行の文字列。改行とバックスラッシュを含まない",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\r\\n\\\\]*$"
    },
    "ref": {
      "description": "ワークスペースのトップからの相対パス（/ 区切り）。原文の位置なら :開始行-終了行 を付ける",
      "type": "string",
      "pattern": "^[^\\s:\\\\]+(:[0-9]+(-[0-9]+)?)?$"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^R-[0-9]{3}$"
    },
    "issue": {
      "type": "object",
      "required": ["id", "status", "title", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/reviewId" },
        "status": { "enum": ["open", "doing", "hold", "resolved", "withdrawn"] },
        "title": { "$ref": "#/$defs/line" },
        "target": { "$ref": "#/$defs/line" },
        "action": { "$ref": "#/$defs/line" },
        "waitingOn": { "enum": ["human", "client"] },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["id", "kind", "date", "by", "text"],
      "properties": {
        "id": { "$ref": "#/$defs/reviewId" },
        "kind": { "enum": ["指摘", "根拠", "修正案", "質問", "回答", "判断", "修正", "確認", "再発", "訂正", "規則提案"] },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}$" },
        "by": { "enum": ["user", "ai", "client", "external"] },
        "text": { "$ref": "#/$defs/line", "x-warnMaxLength": 200 },
        "refs": { "type": "array", "items": { "$ref": "#/$defs/ref" } },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" }
      },
      "additionalProperties": false
    }
  }
}
